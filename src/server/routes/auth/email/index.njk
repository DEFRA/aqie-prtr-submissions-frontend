{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorText %}
        {{ govukErrorSummary({
          titleText: t('common.errorSummaryTitle'),
          errorList: [{ text: errorText, href: "#email" }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ t('auth.email.heading') }}</h1>
      <p class="govuk-body">{{ t('auth.email.intro') }}</p>

      <form action="/sign-in" method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukInput({
          id: "email",
          name: "email",
          type: "email",
          value: email,
          autocomplete: "email",
          spellcheck: false,
          label: {
            text: t('auth.email.label'),
            classes: "govuk-label--m"
          },
          hint: { text: t('auth.email.hint') },
          errorMessage: { text: errorText } if errorText
        }) }}

        {{ govukDetails({
          summaryText: t('auth.email.notRecognised.summary'),
          text: t('auth.email.notRecognised.text')
        }) }}

        {{ govukButton({ text: t('auth.email.button'), preventDoubleClick: true }) }}
      </form>
    </div>
  </div>
{% endblock %}
