{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorText %}
        {{ govukErrorSummary({
          titleText: t('common.errorSummaryTitle'),
          errorList: [{ text: errorText, href: "#email" }]
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ text.heading }}</h1>
      <p class="govuk-body">{{ text.intro }}</p>

      <form action="{{ formAction }}" method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukInput({
          id: "email",
          name: "email",
          type: "email",
          value: email,
          autocomplete: "email",
          spellcheck: false,
          label: {
            text: text.label,
            classes: "govuk-label--m"
          },
          hint: { text: text.hint },
          errorMessage: { text: errorText } if errorText
        }) }}

        {{ govukDetails({
          summaryText: text.notRecognisedSummary,
          text: text.notRecognisedText
        }) }}

        {{ govukButton({ text: text.button, preventDoubleClick: true }) }}
      </form>
    </div>
  </div>
{% endblock %}
